{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
      "paths": {
      "@security/*": ["./packages/security/src/*"],
      "@runtime/*": ["./packages/runtime/*"],
      "@domains/*": ["./packages/domains/*"],
      "@domains/uas/directory": ["./packages/domains/uas/backend/directory/index.ts"],
      "@domains/uas/directory/*": ["./packages/domains/uas/backend/directory/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts"
  ]
}