{ 
	"compilerOptions": {
		"target": "ES2022", 
		"module": "ESNext", 
		"moduleResolution": "Bundler", 
		"rootDir": "src", 
		"outDir": "dist", 
		"declaration": true, 
		"declarationMap": true, 
		"sourceMap": true, 
		"strict": true, 
		"noUncheckedIndexedAccess": true, 
		"exactOptionalPropertyTypes": true, 
		"skipLibCheck": true, 
		"forceConsistentCasingInFileNames": true, 
		"verbatimModuleSyntax": true 
	}, "include": ["src"] 
}