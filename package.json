{
  "name": "daa-architecture",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Digital Adaptive Architecture.",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "backend": "tsx apps/backend/src/server.ts",
    "build": "node scripts/build.mjs",
    "build:packages": "pnpm -r build",
    "start": "node dist/apps/backend/src/server.js",
    "start:production": "node dist/apps/backend/src/server.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "@types/cookie@0.6.0": true,
    "bcryptjs@3.0.3": true,
    "cookie@2.0.1": true
  }
}
