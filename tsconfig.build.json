{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "apps/backend/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.integration.test.ts",
    "**/*.typecheck.*",
    "node_modules",
    "dist"
  ]
}